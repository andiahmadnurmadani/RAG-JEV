# Copy to .env and fill in. Secrets never belong in the repository (PRD 42).
# ---------------------------------------------------------------------------
# Service
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# CORS: kosongkan = hanya same-origin (konsol uji di /ui sudah same-origin).
# Isi hanya bila konsol dibuka dari origin lain, mis. CORS_ORIGINS=http://localhost:5173

# Dokumentasi: bila direktori hasil `mkdocs build` ini ada, aplikasi menyajikannya di /guide
# (Swagger UI tetap di /docs). Kosongkan untuk mematikan. Bangun: bash scripts/build_docs.sh
DOCS_SITE_DIR=site
CORS_ORIGINS=

# Vector store (PRD 8.4/9)
#   QDRANT_URL=http://localhost:6333  -> real Qdrant server
#   QDRANT_URL=                       -> embedded local mode (no container needed)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_LOCAL_PATH=./data/qdrant

# Embedding (PRD 8.2) — PRD-exact model is BAAI/bge-m3.
#   sentence_transformers (torch, ~2.3 GB RAM) | fastembed (ONNX int8) | http | hash (tests)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_FASTEMBED_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=0
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu

# Reranker (PRD 8.3)
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_CANDIDATES=40

# Analitik tabel (xlsx/csv/ods): baris disimpan terstruktur supaya pertanyaan agregat
# ("total", "paling laku") DIHITUNG dari data, bukan ditebak LLM.
TABLE_STORE_PATH=./data/tables.sqlite
TABLE_ANALYTICS_ENABLED=true

# Retrieval (PRD 11-16)
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MIN_CHUNK_TOKENS=40
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_SPARSE_TOP_K=30
RETRIEVAL_HYBRID=true
RRF_K=60
DENSE_WEIGHT=1.0
FINAL_TOP_K=12
RELEVANCE_THRESHOLD=0.35
MAX_CHUNKS_PER_DOCUMENT=8
STRICT_GROUNDING=true

# Seberapa besar isi dokumen yang sampai ke model (lihat docs/large-documents.md).
# CONTEXT_MAX_TOKENS 24000 dipilih dari pengukuran nyata: PDF 20 halaman = 19.038 token,
# jadi dokumen sekelas itu muat utuh. Model berjendela kecil: turunkan nilainya.
CONTEXT_MAX_TOKENS=24000
# Ikuti dokumen yang terambil sampai habis (urutan dokumen), bukan hanya potongan teratas.
CONTEXT_EXPAND_DOCUMENTS=true
CONTEXT_EXPAND_MAX_DOCUMENTS=3
CONTEXT_EXPAND_MIN_CHUNKS=2

# Generation (PRD 8.1) — any OpenAI-compatible chat endpoint (vLLM/Ollama/gateway)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-4B
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1
LLM_CONTEXT_CHARS=96000
ANSWER_LANGUAGE=id

# Jev orchestration (PRD 18/19) - decision layer only, never authorization
JEV_ENABLED=true
JEV_MODE=live
# Two mutually exclusive transports. "mcp" = jevai.org MCP server (tools/call).
# "systemone" = native decision endpoint POST {state, model, questions}.
JEV_PROVIDER=mcp
JEV_MCP_URL=https://www.jevai.org/api/mcp
JEV_ROUTE_TOOL=jev_route_task
JEV_HEALTH_TOOL=jev_check_research
# Only read when JEV_PROVIDER=systemone. Examples:
#   self-hosted 9Router : http://localhost:20128/v1/systemone   + JEV_MODEL=oc/jev-1.13-free
#   vendor              : https://api.typesafe.ai/v1/systemone   + JEV_MODEL=jev-1.13.0
JEV_SYSTEMONE_URL=
JEV_MODEL=
JEV_API_KEY=
JEV_TIMEOUT=20
# /ready is polled; each System One probe costs tokens, so cache the liveness answer.
JEV_HEALTH_CACHE_SECONDS=300

# Auth / tenant context (PRD 6/21/34)
# JSON map of API key -> trusted context (never fetched from a prompt)
API_KEYS_JSON={}
# Keys created from the settings screen (Settings -> Kunci API). Stores sha256 of each key,
# never the key itself; mode 0600. Keys in API_KEYS_JSON are still honoured alongside it.
API_KEYS_PATH=./data/api_keys.json
KMS_SHARED_SECRET=
TENANT_CONTEXT_HEADER=X-Tenant-Context
REQUIRE_TENANT_CONTEXT_TOKEN=false
RATE_LIMIT_PER_MINUTE=240

# Files / worker
MAX_UPLOAD_MB=32
# Daftar ekstensi yang boleh jadi knowledge (kosong = seluruh katalog yang didukung mesin ini).
# Bisa dipersempit/diubah kapan saja dari layar Pengaturan (perlu izin admin) tanpa restart.
UPLOAD_EXTENSIONS=
STORAGE_DIR=./data/storage
SPARSE_DIR=./data/sparse
JOB_STORE_PATH=./data/jobs.json
INDEXING_WORKERS=1

# ---- sumber dari web (knowledge dari halaman/situs + berkas publik) ----
WEB_CRAWL_ENABLED=true
WEB_CRAWL_MAX_PAGES=20
WEB_CRAWL_MAX_DEPTH=2
WEB_CRAWL_SAME_HOST=true
WEB_CRAWL_FOLLOW_FILES=true
WEB_CRAWL_RESPECT_ROBOTS=true
# Izinkan URL ke alamat privat/internal. BAWAAN MATI: menyalakannya membuat server ini bisa
# disuruh membaca jaringan tempat ia berjalan (SSRF). Nyalakan hanya untuk intranet tepercaya.
ALLOW_PRIVATE_URLS=false

# ---- ringkasan dokumen (knowledge turunan) ----
# Saat dokumen diindeks, isinya diringkas dan ringkasannya ikut diindeks. Pertanyaan yang
# meminta ringkasan dijawab dari ringkasan itu, bukan dari sebagian hasil pencarian.
DOCUMENT_SUMMARY_ENABLED=true
SUMMARY_WINDOW_TOKENS=12000
SUMMARY_MAX_TOKENS=2048
SUMMARY_MAX_DOCUMENTS=3

# Ringkasan dikerjakan di jalur terpisah dari pengindeksan: panggilan LLM yang panjang tidak
# menahan antrian unggahan. Naikkan bila banyak dokumen diunggah bersamaan.
SUMMARY_WORKERS=2
# Batas waktu membuat ringkasan (detik) dan jumlah tahap (map-reduce).
SUMMARY_BUDGET_SECONDS=120
SUMMARY_MAX_STAGES=12
